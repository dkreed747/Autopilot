{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "amd64-debug",
      "displayName": "amd64 Debug",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build",
      "installDir": "${sourceDir}/install",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AUTOPILOT_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "amd64-release",
      "displayName": "amd64 Release",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build",
      "installDir": "${sourceDir}/install",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AUTOPILOT_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "amd64-debug", "configurePreset": "amd64-debug" },
    { "name": "amd64-release", "configurePreset": "amd64-release" }
  ],
  "testPresets": [
    {
      "name": "amd64-debug",
      "configurePreset": "amd64-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "amd64-release",
      "configurePreset": "amd64-release",
      "output": { "outputOnFailure": true }
    }
  ]
}
